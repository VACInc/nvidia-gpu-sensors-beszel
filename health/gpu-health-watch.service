[Unit]
Description=Log GPU hot spot / hottest VRAM chip and alert on GPU slowdowns and link errors

[Service]
Type=oneshot
TimeoutStartSec=90
ExecStart=/opt/gpu-health/gpu-health-watch.sh
Nice=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
LogsDirectory=gpu-health
StateDirectory=gpu-health-watch
StateDirectoryMode=0700
# Sandbox. Runs as root for BAR0 and /dev/nvidia*, so no PrivateDevices,
# DeviceAllow or ProtectClock (which implies a device allow-list), and the
# capability set is left alone. curl needs IP for ntfy.
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
