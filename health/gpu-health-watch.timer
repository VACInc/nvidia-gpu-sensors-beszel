[Unit]
Description=Run gpu-health-watch every 30s

[Timer]
OnBootSec=40s
# OnBootSec is lost if a slow boot starts timers.target after that mark, and
# OnUnitActiveSec never arms until the service has run once this boot.
OnActiveSec=15s
OnUnitActiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
